NETSCOPE_CONTROL_PLANE_URL=https://netscope.example.invalid
NETSCOPE_AGENT_NAME=branch-office-01
NETSCOPE_ENROLLMENT_TOKEN=replace-with-short-lived-single-use-token
NETSCOPE_DATA_DIR=./data
