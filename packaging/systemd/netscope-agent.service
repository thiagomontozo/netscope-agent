[Unit]
Description=NetScope secure outbound network agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=netscope
Group=netscope
EnvironmentFile=/etc/netscope-agent/agent.env
ExecStart=/usr/local/bin/netscope-agent
Restart=on-failure
RestartSec=10s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/netscope-agent
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
